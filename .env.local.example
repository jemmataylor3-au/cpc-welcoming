# Copy this file to .env.local and fill in your values.
# Get these from your Supabase project: Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Public VAPID key for push notifications — safe to expose to the browser.
# Generate both keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# Server-side only — used by Edge Functions, NOT the Next.js app itself.
# Set these as Supabase Edge Function secrets (see README), not here.
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=
# RESEND_FROM_ADDRESS=welcoming@yourchurchdomain.org
